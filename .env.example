# Supabase-project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# De drie accounts (klant, serviceteam, beheerder), alleen op de server bekend.
# Het wachtwoord van elk account in Supabase is de inlogcode; geef elk account een andere code.
ACCOUNT_EMAILS=klant@dakru.nl,service@dakru.nl,beheer@dakru.nl
